# Copy this file to `.env` and fill in your own keys before running the app.
# Never commit `.env` to version control.

# Stripe client publishable key (pk_test_... for sandbox, pk_live_... for production)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Google Maps & Places API key (restrict by app package/bundle ID and API scope)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
